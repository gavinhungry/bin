#!/bin/bash

upower --dump |
  awk '
    /^Device:/         { kind = vendor = model = "" }
    /^  [a-z][a-z-]*$/ { kind = $1 }
    $1 == "vendor:"    { $1 = ""; vendor = substr($0, 2) }
    $1 == "model:"     { $1 = ""; model  = substr($0, 2) }
    $1 == "percentage:" && model != "" {
      $1 = ""
      print (vendor != "" ? vendor " " : "") model \
            (kind != "" ? " (" toupper(kind) ")" : "") ":" $0
    }
  ' |
  sort -u
