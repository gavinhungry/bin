#!/bin/bash

source $(dirname "${BASH_SOURCE[0]}")/.abash/abash.sh

DT=/sys/firmware/devicetree/base
DMI=/sys/devices/virtual/dmi/id

IGNORED_MODEL_NAMES=(
  'Default string'
  'To be filled by O.E.M.'
  'System Product Name'
)

if [ -d "$DT" ]; then
  tr -d '\0' < "$DT"/model
  echo
elif [ -d "$DMI" ]; then
  VENDOR=$(kat $DMI/sys_vendor || kat $DMI/board_vendor)

  NAMES=(
    "$(kat $DMI/board_name)"
    "$(kat $DMI/product_family)"
    "$(kat $DMI/product_name)"
  )

  MODEL=
  for NAME in "${NAMES[@]}"; do
    if [ "${#NAME}" -gt "${#MODEL}" ] && ! includes IGNORED_MODEL_NAMES "$NAME"; then
      MODEL="$NAME"
    fi
  done

  echo $VENDOR $MODEL
fi
