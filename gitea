#!/bin/bash

if [ -z "$GITEA_DOMAIN" ]; then
  echo "GITEA_DOMAIN is not set" >&2
  exit 1
fi

BASE_URL=$(git remote get-url origin | sed "s|^gitea:|https://${GITEA_DOMAIN}/|; s|\.git$||")
[[ "$BASE_URL" = "https://${GITEA_DOMAIN}/"* ]] || exit 1

get_branch_suffix() {
  BRANCH=$(git rev-parse --abbrev-ref HEAD 2> /dev/null)
  if [[ -n "$BRANCH" && "$BRANCH" != "main" && "$BRANCH" != "master" && "$BRANCH" != "HEAD" ]]; then
    echo "${1}/branch/${BRANCH}"
  elif [ "${2:-1}" != 0 ]; then
    echo $1
  fi
}

get_ref_path() {
  BRANCH=$(git rev-parse --abbrev-ref HEAD 2> /dev/null)
  if [[ -n "$BRANCH" && "$BRANCH" != "HEAD" ]]; then
    echo "branch/${BRANCH}"
  else
    echo "commit/$(git rev-parse HEAD)"
  fi
}

get_head_sha() {
  git rev-parse '@{u}' 2> /dev/null || git rev-parse HEAD
}

open_url() {
  if [ -n "$SSH_TTY" ]; then
    echo "$1"
  else
    ($BROWSER "$1" &> /dev/null &)
  fi
}

open_page() {
  PAGE_NAME=$1
  [ -n "$3" ] && PAGE_NAME=$2

  URL=$(echo "${BASE_URL}/$PAGE_NAME/$3" | sed 's/\/*$//')
  open_url "$URL"
  exit
}

case $1 in
  c|commit|commits)    open_page commits/$(get_ref_path) commit $2 ;;
  h|head)              open_page commit/$(get_head_sha) ;;
  i|issue|issues)      open_page issues issues $2 ;;
  p|pull|pulls|pr|prs) open_page pulls pulls $2 ;;
  a|actions|ci)        open_page actions ;;
  s|settings)          open_page settings ;;
  *)                   open_page $(get_branch_suffix src 0) ;;
esac
