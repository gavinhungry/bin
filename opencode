#!/bin/bash

source $(dirname "${BASH_SOURCE[0]}")/.abash/abash.sh

#
# args
#
# Consume wrapper-only args, passing everything else (and everything after
# `--`) through to opencode.
#

WSL_INTEROP_ENABLED=0
OPENCODE_ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --wsl-interop) WSL_INTEROP_ENABLED=1 ;;
    --) OPENCODE_ARGS+=("$@"); break ;;
    *) OPENCODE_ARGS+=("$1") ;;
  esac
  shift
done
set -- "${OPENCODE_ARGS[@]}"

#
# workspace directory
#
# This is primarily a footgun-prevention mechanism, and not security
# enforcement. Allow workspaces either within `WORKSPACE_BASE_DIR`, even if it
# is just an explicitly-created symlink to an external directory.
#

WORKSPACE_BASE_DIR=${WORKSPACE_BASE_DIR:-$XDG_DEVEL_HOME}

[ -n "$WORKSPACE_BASE_DIR" ] || die 'WORKSPACE_BASE_DIR not set'
[ -d "$WORKSPACE_BASE_DIR" ] || die 'WORKSPACE_BASE_DIR does not exist'

WORKSPACE_DIR="$WORKSPACE_BASE_DIR"

if [[
  "$PWD" == "$WORKSPACE_BASE_DIR" ||
  "$PWD" == "$WORKSPACE_BASE_DIR"/*
]]; then
  WORKSPACE_DIR="$PWD"
else
  if ! arge help && ! arge version; then
    warn "Workspace should be within $WORKSPACE_BASE_DIR"
  fi
fi

WORKSPACE_BASENAME=$(basename $WORKSPACE_DIR)

#
# opencode2
#
# Find standlone opencode x86 binary installed globally with pnpm. This avoids
# the postinstall script required by the platform-agnostic opencode-ai package.
#

OPENCODE_HOME_DIR="$XDG_LOCAL_HOME"/opt/opencode

OPENCODE_INSTALL_DIR=$(
  pnpm -g list --long --json |
  jq -r '.[0].dependencies["@opencode/cli-linux-x64"].path'
)

[ -d "$OPENCODE_INSTALL_DIR" ] || die 'opencode not installed'

#
# editor
#
# Construct bwrap bind args for editor-specific user configurations
#

EDITOR_BIND_ARGS=()
if [ "$EDITOR" == emacs ]; then
  if [ -d '/usr/libexec/emacs' ]; then
    EDITOR_BIND_ARGS+=(--ro-bind /usr/libexec/emacs /usr/libexec/emacs)
  fi

  EDITOR_BIND_ARGS+=(--ro-bind /usr/share/emacs /usr/share/emacs)
  EDITOR_BIND_ARGS+=(--ro-bind "$HOME/.emacs" "$HOME/.emacs")
  EDITOR_BIND_ARGS+=(--ro-bind "$HOME/.emacs.d" "$HOME/.emacs.d")
fi

SSL_DIR_ARGS=()
for DIR in /etc/ssl /etc/ca-certificates /etc/pki; do
  [ -d "$DIR" ] && SSL_DIR_ARGS+=(--ro-bind "$DIR" "$DIR")
done

#
# title
#
# Use the PID of this script (in hex) as a human-readable ID, which is added to
# the WM_NAME, later used to match against the active window in order to
# determine if notifications should be displayed.
#

PID_HEX=$(printf '%X\n' $$)
export OPENCODE_WM_NAME="${WORKSPACE_BASENAME}${__TITLE_SEP:-" - "}OpenCode ($PID_HEX)"
wmname "$OPENCODE_WM_NAME"

#
# external dir
#

OPENCODE_SANDBOX_EXT_DIR=$(mktemp -d -p "$XDG_CACHE_HOME" opencode-ext-${PID_HEX}-XXXX)

touch "$OPENCODE_SANDBOX_EXT_DIR"/.notify
surveil --path "$OPENCODE_SANDBOX_EXT_DIR"/.notify "$OPENCODE_HOME_DIR"/bin/notify-args 2> /dev/null &
SURVEIL_PID=$!

ext_dir_cleanup() {
  kill $SURVEIL_PID $XVFB_PID 2> /dev/null
  rm -fr "$OPENCODE_SANDBOX_EXT_DIR"
}

trap ext_dir_cleanup EXIT

#
# clipboard
#
# OpenCode writes the clipboard natively via Wayland/X11 (plus OSC 52 to the
# terminal). Outside of WSL, give the sandbox a private Xvfb display and mirror
# its clipboard to the host clipboard. The host clipboard is never exposed to
# the sandbox. Under WSL, Windows Terminal handles OSC 52 directly.
#
# Each display requires its own cookie, so other users and other sandboxed
# instances (reachable via abstract sockets) cannot connect to it.
#

XVFB_BIND_ARGS=()
if [ ! -d /run/WSL ]; then
  XVFB_AUTH="$OPENCODE_SANDBOX_EXT_DIR"/.Xauthority
  XVFB_COOKIE=$(mcookie)

  # Xvfb loads every cookie in its auth file regardless of display name;
  # clients look up the entry for their display, added once it is known.
  touch "$XVFB_AUTH"
  xauth -q -f "$XVFB_AUTH" add :0 . "$XVFB_COOKIE"

  mkfifo "$OPENCODE_SANDBOX_EXT_DIR"/.xvfb
  Xvfb -displayfd 3 -auth "$XVFB_AUTH" -nolisten tcp \
    3> "$OPENCODE_SANDBOX_EXT_DIR"/.xvfb \
    2> "$OPENCODE_SANDBOX_EXT_DIR"/.xvfb.log &
  XVFB_PID=$!
  read -r XVFB_DISPLAY < "$OPENCODE_SANDBOX_EXT_DIR"/.xvfb
  if [ -z "$XVFB_DISPLAY" ]; then
    cat "$OPENCODE_SANDBOX_EXT_DIR"/.xvfb.log >&2
    die 'Xvfb failed to start'
  fi

  xauth -q -f "$XVFB_AUTH" add ":$XVFB_DISPLAY" . "$XVFB_COOKIE"

  # scoped per command, so `clip` still uses the host display and credentials
  XVFB_ENV=(DISPLAY=":$XVFB_DISPLAY" XAUTHORITY="$XVFB_AUTH")
  (
    while env "${XVFB_ENV[@]}" clipnotify -s clipboard; do
      env "${XVFB_ENV[@]}" xclip -selection clipboard -o | clip
    done
  ) 2> /dev/null &

  XVFB_BIND_ARGS=(
    --ro-bind /tmp/.X11-unix/X"$XVFB_DISPLAY" /tmp/.X11-unix/X"$XVFB_DISPLAY"
    --ro-bind "$XVFB_AUTH" "$XVFB_AUTH"
    --setenv DISPLAY ":$XVFB_DISPLAY"
    --setenv XAUTHORITY "$XVFB_AUTH"
  )
fi

#
# wsl interop
#
# Allow launching Windows executables via WSL interop. Windows processes run on
# the host, entirely outside of the sandbox, so this effectively removes it as a
# security boundary. The Windows drive is read-only, though a workspace within
# it remains writable.
#

WSL_BIND_ARGS=()
SANDBOX_PATH="$XDG_LOCAL_HOME"/bin:/usr/bin
if [ $WSL_INTEROP_ENABLED -eq 1 ]; then
  [ -d /run/WSL ] || die 'WSL interop requires WSL'
  [ -n "$WSL_INTEROP" ] || die 'WSL_INTEROP not set'
  warn 'WSL interop enabled; Windows processes run outside the sandbox'

  WSL_SYSTEMDRIVE=$(wslpath -u "$(wsl-env-var SYSTEMDRIVE)\\")
  WSL_SYSTEMDRIVE=${WSL_SYSTEMDRIVE%/}

  WSL_SYSTEMROOT=$(wslpath -u $(wsl-env-var SYSTEMROOT))

  WSL_BIND_ARGS=(
    --ro-bind /init /init
    --ro-bind /run/WSL /run/WSL
    --ro-bind "$WSL_SYSTEMDRIVE" "$WSL_SYSTEMDRIVE"
    --setenv WSL_INTEROP "$WSL_INTEROP"
    --setenv WSL_DISTRO_NAME "$WSL_DISTRO_NAME"
    --setenv WSLENV "$WSLENV"
  )

  SANDBOX_PATH+=:"$WSL_SYSTEMROOT"/System32
  SANDBOX_PATH+=:"$WSL_SYSTEMROOT"/System32/WindowsPowerShell/v1.0
fi

#
# bwrap
#
# Execute bwrap and launch opencode.
#
# The opencode binary itself is executed within an interactive bash shell, with
# arguments to this script passed directly. This is a workaround for:
# https://github.com/anomalyco/opencode/issues/9860
#

/usr/bin/bwrap \
  --unshare-pid \
  --proc /proc \
  --dev /dev \
  --ro-bind /bin /bin \
  --ro-bind /usr/bin /usr/bin \
  --ro-bind /usr/share/terminfo /usr/share/terminfo \
  --ro-bind /lib /lib \
  --ro-bind /usr/lib /usr/lib \
  --ro-bind /lib64 /lib64 \
  --ro-bind /usr/lib64 /usr/lib64 \
  --ro-bind /etc/alternatives /etc/alternatives \
  --ro-bind /etc/resolv.conf /etc/resolv.conf \
  "${SSL_DIR_ARGS[@]}" \
  --ro-bind "$OPENCODE_INSTALL_DIR" /opt/opencode \
  --dir "$HOME" \
  --tmpfs /tmp \
  --tmpfs "$XDG_CACHE_HOME" \
  --bind "$OPENCODE_SANDBOX_EXT_DIR" "$OPENCODE_SANDBOX_EXT_DIR" \
  --bind "$OPENCODE_HOME_DIR"/cache "$XDG_CACHE_HOME"/opencode \
  --bind "$OPENCODE_HOME_DIR"/config "$XDG_CONFIG_HOME"/opencode \
  --bind "$OPENCODE_HOME_DIR"/data "$XDG_DATA_HOME"/opencode \
  --bind "$OPENCODE_HOME_DIR"/state "$XDG_STATE_HOME"/opencode \
  --ro-bind "$OPENCODE_HOME_DIR"/bin "$XDG_LOCAL_HOME"/bin \
  "${WSL_BIND_ARGS[@]}" \
  --bind "$WORKSPACE_DIR" "$WORKSPACE_DIR" \
  --chdir "$WORKSPACE_DIR" \
  --clearenv \
  --setenv WORKSPACE_BASENAME "$WORKSPACE_BASENAME" \
  --setenv HOME "$HOME" \
  --setenv PATH "$SANDBOX_PATH" \
  --setenv PWD "$WORKSPACE_DIR" \
  --setenv TERM "$TERM" \
  --setenv EDITOR "drain-stdin $EDITOR" \
  --setenv XDG_CONFIG_HOME "$XDG_CONFIG_HOME" \
  --setenv XDG_LOCAL_HOME "$XDG_LOCAL_HOME" \
  --setenv XDG_DATA_HOME "$XDG_DATA_HOME" \
  --setenv XDG_STATE_HOME "$XDG_STATE_HOME" \
  --setenv XDG_CACHE_HOME "$XDG_CACHE_HOME" \
  --setenv OPENCODE_WM_NAME "$OPENCODE_WM_NAME" \
  --setenv OPENCODE_SANDBOX_EXT_DIR "$OPENCODE_SANDBOX_EXT_DIR" \
  --setenv OPENCODE_DISABLE_FREE_MODELS 1 \
  --setenv OPENCODE_DISABLE_PROJECT_CONFIG 1 \
  "${EDITOR_BIND_ARGS[@]}" \
  "${XVFB_BIND_ARGS[@]}" \
/bin/bash -ic '
  /opt/opencode/bin/opencode --standalone "$@"
  drain-stdin
' /bin/bash "$@"
