#!/bin/bash

source $(dirname "${BASH_SOURCE[0]}")/.abash/abash.sh

#
# Arguments
#
# Consume wrapper-only args, passing everything else (and everything after
# `--`) through to opencode.
#

NO_SANDBOX=0
HERE=0
WSL_INTEROP_ENABLED=0
XVFB_PID=
OPENCODE_ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --no-sandbox) NO_SANDBOX=1 ;;
    --here) HERE=1 ;;
    --wsl-interop) WSL_INTEROP_ENABLED=1 ;;
    --) OPENCODE_ARGS+=("$@"); break ;;
    *) OPENCODE_ARGS+=("$1") ;;
  esac
  shift
done
set -- "${OPENCODE_ARGS[@]}"

if [ $NO_SANDBOX -eq 1 ]; then
  if [ $HERE -eq 1 ]; then
    msg 'Ignoring --here (no sandbox)' >&2
    HERE=0
  fi
  if [ $WSL_INTEROP_ENABLED -eq 1 ]; then
    msg 'Ignoring --wsl-interop (no sandbox)' >&2
    WSL_INTEROP_ENABLED=0
  fi
  warn 'Disabling sandbox (allows full user access)'
  if ! arge help && ! arge version; then
    confirm -n 'Continue?' < /dev/tty
  fi
fi

if [ $WSL_INTEROP_ENABLED -eq 1 ]; then
  [ -d /run/WSL ] || die '--wsl-interop requires WSL'
  [ -n "$WSL_INTEROP" ] || die '--wsl-interop: WSL_INTEROP not set'

  warn 'Enabling WSL interop (Windows programs bypass sandbox)'
  if ! arge help && ! arge version; then
    confirm -n 'Continue?' < /dev/tty
  fi
fi

#
# Workspace directory
#
# Without the sandbox, the current directory is always used. With it, this is
# primarily a footgun-prevention mechanism, and not security enforcement. The
# workspace must be within `OPENCODE_SANDBOX_WORKSPACE_BASE_DIR`, either
# directly or via an explicitly-created symlink to an external directory.
#
# The workspace is resolved from the directory argument, if any (in which case
# it is removed, as the sandbox starts in the workspace anyway), or else from
# the current directory.
#
# Workspace symlinks are found anywhere within the base dir, without
# descending into projects (directories containing .git), so symlinks within
# a project never count. Their targets are mounted when within the workspace,
# so that sessions through them work from the base dir too.
#
# When started from outside the base dir, look for a workspace symlink that
# points to the start directory, or to one of its parents, and use the
# equivalent path through that symlink. This keeps the workspace path the same
# however it is reached. Otherwise, fall back to the base dir, e.g. to pick an
# existing session from there, unless the directory was given explicitly.
#
# --here bypasses the check, after confirmation, using the start directory.
#

LINK_BIND_ARGS=()

if [ $NO_SANDBOX -eq 1 ]; then
  WORKSPACE_DIR="$PWD"
else
  OPENCODE_SANDBOX_WORKSPACE_BASE_DIR=${OPENCODE_SANDBOX_WORKSPACE_BASE_DIR:-$XDG_DEVEL_HOME}

  [ -n "$OPENCODE_SANDBOX_WORKSPACE_BASE_DIR" ] ||
    die 'No workspace base: set OPENCODE_SANDBOX_WORKSPACE_BASE_DIR or XDG_DEVEL_HOME'

  [ -d "$OPENCODE_SANDBOX_WORKSPACE_BASE_DIR" ] ||
    die "Workspace base $(bpath "$OPENCODE_SANDBOX_WORKSPACE_BASE_DIR") does not exist"

  BASE_DIR=$OPENCODE_SANDBOX_WORKSPACE_BASE_DIR

  in_dir() {
    [[ "$1" == "$2" || "$1" == "$2"/* ]]
  }

  # Find the directory argument: the first positional, unless a subcommand
  DIR_ARG_INDEX=
  ARGS=("$@")
  for (( I=0; I<${#ARGS[@]}; I++ )); do
    case "${ARGS[$I]}" in
      --) (( I + 1 < ${#ARGS[@]} )) && DIR_ARG_INDEX=$((I + 1)); break ;;
      --server|--session|-s|--prompt|--completions|--log-level) (( I++ )) ;;
      -*) ;;
      upgrade|update|uninstall|acp|api|debug|auth|mcp|plugin|models|stats|\
      mini|run|session|service|reload|pair|serve) break ;;
      *) DIR_ARG_INDEX=$I; break ;;
    esac
  done

  START_DIR=$PWD
  if [ -n "$DIR_ARG_INDEX" ]; then
    DIR_ARG=${ARGS[$DIR_ARG_INDEX]}
    [ -d "$DIR_ARG" ] || die "$(bpath "$DIR_ARG") is not a directory"
    START_DIR=$(cd "$DIR_ARG" && pwd) || die "Unable to access $(bpath "$DIR_ARG")"
    unset 'ARGS[DIR_ARG_INDEX]'
    set -- "${ARGS[@]}"
  fi

  WORKSPACE_DIR=

  if arge help || arge version; then
    in_dir "$START_DIR" "$BASE_DIR" && WORKSPACE_DIR=$START_DIR || WORKSPACE_DIR=$BASE_DIR
  else
    LINKS=()
    LINK_TARGETS=()
    while read -r -d '' LINK; do
      LINKS+=("$LINK")
      LINK_TARGETS+=("$(readlink -f "$LINK")")
    done < <(
      find "$BASE_DIR" \
        -type d -exec test -e {}/.git \; -prune -o \
        -name node_modules -prune -o \
        -type l -xtype d -print0
    )

    if in_dir "$START_DIR" "$BASE_DIR"; then
      WORKSPACE_DIR=$START_DIR
    else
      REAL_START_DIR=$(cd "$START_DIR" && pwd -P)

      for I in "${!LINKS[@]}"; do
        if in_dir "$REAL_START_DIR" "${LINK_TARGETS[$I]}"; then
          WORKSPACE_DIR="${LINKS[$I]}${REAL_START_DIR#"${LINK_TARGETS[$I]}"}"
          msg "Using workspace $(bpath "$WORKSPACE_DIR") (via symlink)" >&2
          break
        fi
      done
    fi

    if [ -z "$WORKSPACE_DIR" ] && [ $HERE -eq 1 ]; then
      warn "Allowing full access to $(bpath "$START_DIR")"
      confirm -n 'Continue?' < /dev/tty
      WORKSPACE_DIR=$START_DIR
    fi

    if [ -z "$WORKSPACE_DIR" ]; then
      [ -z "$DIR_ARG_INDEX" ] ||
        die "$(bpath "$START_DIR") is outside workspace $(bpath "$BASE_DIR")"

      WORKSPACE_DIR=$BASE_DIR
      msg "Using workspace $(bpath "$WORKSPACE_DIR")" >&2
    fi

    for I in "${!LINKS[@]}"; do
      if in_dir "${LINKS[$I]}" "$WORKSPACE_DIR" &&
        ! in_dir "${LINK_TARGETS[$I]}" "$BASE_DIR"; then
        LINK_BIND_ARGS+=(--bind "${LINK_TARGETS[$I]}" "${LINK_TARGETS[$I]}")
      fi
    done
  fi
fi

WORKSPACE_BASENAME=$(basename "$WORKSPACE_DIR")

#
# OpenCode 2
#
# Find standlone opencode x86 binary installed globally with pnpm. This avoids
# the postinstall script required by the platform-agnostic opencode-ai package.
#

OPENCODE_HOME_DIR="$XDG_LOCAL_HOME"/opt/opencode

OPENCODE_INSTALL_DIR=$(
  pnpm -g list --long --json |
  jq -r '.[0].dependencies["@opencode/cli-linux-x64"].path'
)

[ -d "$OPENCODE_INSTALL_DIR" ] || die 'OpenCode not installed'

#
# Editor
#
# Construct bwrap bind args for editor-specific user configurations
#

EDITOR_BIND_ARGS=()
EDITOR_CMD="$EDITOR"
if [ "$EDITOR" == emacs ]; then
  EDITOR_CMD='emacs -nw'

  for DIR in \
    /usr/libexec/emacs \
    /usr/share/emacs \
    /usr/share/emacsen-common \
    /usr/share/dictionaries-common \
    /etc/emacs \
    /var/lib/emacsen-common \
    "$HOME/.emacs" \
    "$HOME/.emacs.d"
  do
    EDITOR_BIND_ARGS+=(--ro-bind-try "$DIR" "$DIR")
  done
fi

#
# Title
#

TITLE_PREFIX=
if [ $NO_SANDBOX -eq 1 ]; then
  TITLE_PREFIX='[!!]'
elif [ $WSL_INTEROP_ENABLED -eq 1 ]; then
  TITLE_PREFIX='[<>]'
fi

[ -n "$TITLE_PREFIX" ] && TITLE_PREFIX+=' '

TITLE_SUFFIX=OpenCode
[ -n "$SSH_CONNECTION" ] && TITLE_SUFFIX+=" (${HOSTNAME%%.*})"

TITLE_SEP="${__TITLE_SEP_CHAR:-"-"}"

# The term-title plugin inserts the current session's project between the
# prefix and suffix, e.g. "[!!] bin - OpenCode (host)".
wmname "${TITLE_PREFIX}${TITLE_SUFFIX}"

#
# Instance directory
#
# Per-instance state, named after the workspace and removed on exit.
# instance.json identifies the instance (e.g. to match it to a window, or find
# leftovers from an instance that did not exit cleanly). Not visible within the
# sandbox.
#

INSTANCES_DIR="$XDG_CACHE_HOME"/opencode-run
mkdir -pm 700 "$INSTANCES_DIR"

# safe for use as a (visible) filename, and never parsed as a mktemp option
INSTANCE_NAME=$WORKSPACE_BASENAME
[ "$INSTANCE_NAME" == / ] && INSTANCE_NAME=root
INSTANCE_NAME=${INSTANCE_NAME//[^A-Za-z0-9._-]/_}
[[ "$INSTANCE_NAME" == [-.]* ]] && INSTANCE_NAME=_${INSTANCE_NAME:1}
INSTANCE_NAME=${INSTANCE_NAME:0:64}

INSTANCE_DIR=$(mktemp -d -p "$INSTANCES_DIR" "$INSTANCE_NAME"-XXXXXX) ||
  die 'Failed to create instance dir'

jq -n \
  --argjson pid $$ \
  --arg started "$(date -Iseconds)" \
  --arg workspace "$WORKSPACE_DIR" \
  --arg tty "$(tty -s && tty)" \
  --arg sty "$STY" \
  --arg window "$WINDOW" \
  --argjson sandbox $([ $NO_SANDBOX -eq 0 ] && echo true || echo false) \
  --argjson wsl_interop $([ $WSL_INTEROP_ENABLED -eq 1 ] && echo true || echo false) \
  '{
    $pid, $started, $workspace,
    tty: (if $tty == "" then null else $tty end),
    screen: (if $sty == "" then null else { session: $sty, window: $window } end),
    $sandbox, $wsl_interop
  }' > "$INSTANCE_DIR"/instance.json

cleanup() {
  kill $SURVEIL_PID $XVFB_PID 2> /dev/null

  local SRC="$CONFIG_OVERLAY_DIR"/config/cli.json
  local DEST="$OPENCODE_HOME_DIR"/config/cli.json

  if [ -f "$SRC" ] && ! cmp -s "$SRC" "$DEST"; then
    cp "$SRC" "$DEST".tmp.$$ && mv -f "$DEST".tmp.$$ "$DEST"
  fi

  # overlayfs leaves an inaccessible dir within the work dir
  chmod -R u+rwx "$INSTANCE_DIR" 2> /dev/null
  rm -fr "$INSTANCE_DIR"
}

trap cleanup EXIT

#
# External directory
#
# The ext dir is shared with the sandbox. Notifications are written to .notify,
# and sent on the host by notify-args.
#

OPENCODE_SANDBOX_EXT_DIR="$INSTANCE_DIR"/ext
mkdir -m 700 "$OPENCODE_SANDBOX_EXT_DIR"

touch "$OPENCODE_SANDBOX_EXT_DIR"/.notify
surveil --path "$OPENCODE_SANDBOX_EXT_DIR"/.notify "$OPENCODE_HOME_DIR"/bin/notify-args 2> /dev/null &
SURVEIL_PID=$!

#
# Config overlay
#
# Sandbox only. OpenCode saves cli.json by writing a temp file and renaming it,
# so it needs a writable config dir. Overlay the config dir instead, so writes
# land in a per-instance upper dir, kept outside of the sandbox. On exit, only
# cli.json is copied back; everything else written to the config dir (e.g. the
# plugin version pinned in package.json) is discarded.
#

CONFIG_OVERLAY_DIR="$INSTANCE_DIR"/overlay

if [ $NO_SANDBOX -eq 0 ]; then
  /usr/bin/bwrap --help | grep -q -- --overlay-src ||
    die 'bwrap does not support --overlay (requires 0.8+)'

  mkdir -m 700 "$CONFIG_OVERLAY_DIR" "$CONFIG_OVERLAY_DIR"/config "$CONFIG_OVERLAY_DIR"/work
fi

#
# Clipboard
#
# Sandbox only; without it, the host clipboard is used directly.
#
# OpenCode writes the clipboard natively via Wayland/X11 (plus OSC 52 to the
# terminal). Outside of WSL, give the sandbox a private Xvfb display and mirror
# its clipboard to the host clipboard. The host clipboard is never exposed to
# the sandbox. Under WSL, Windows Terminal handles OSC 52 directly.
#
# Each display requires its own cookie, so other users and other sandboxed
# instances (reachable via abstract sockets) cannot connect to it.
#

XVFB_BIND_ARGS=()
if [ $NO_SANDBOX -eq 0 ] && [ ! -d /run/WSL ]; then
  XVFB_AUTH="$OPENCODE_SANDBOX_EXT_DIR"/.Xauthority
  XVFB_COOKIE=$(mcookie)

  # Xvfb loads every cookie in its auth file regardless of display name;
  # clients look up the entry for their display, added once it is known.
  touch "$XVFB_AUTH"
  xauth -q -f "$XVFB_AUTH" add :0 . "$XVFB_COOKIE"

  mkfifo "$OPENCODE_SANDBOX_EXT_DIR"/.xvfb
  Xvfb -displayfd 3 -auth "$XVFB_AUTH" -nolisten tcp \
    3> "$OPENCODE_SANDBOX_EXT_DIR"/.xvfb \
    2> "$OPENCODE_SANDBOX_EXT_DIR"/.xvfb.log &
  XVFB_PID=$!
  read -r XVFB_DISPLAY < "$OPENCODE_SANDBOX_EXT_DIR"/.xvfb
  if [ -z "$XVFB_DISPLAY" ]; then
    cat "$OPENCODE_SANDBOX_EXT_DIR"/.xvfb.log >&2
    die 'Xvfb failed to start'
  fi

  xauth -q -f "$XVFB_AUTH" add ":$XVFB_DISPLAY" . "$XVFB_COOKIE"

  # scoped per command, so `clip` still uses the host display and credentials
  XVFB_ENV=(DISPLAY=":$XVFB_DISPLAY" XAUTHORITY="$XVFB_AUTH")
  (
    while env "${XVFB_ENV[@]}" clipnotify -s clipboard; do
      env "${XVFB_ENV[@]}" xclip -selection clipboard -o | clip
    done
  ) 2> /dev/null &

  XVFB_BIND_ARGS=(
    --ro-bind /tmp/.X11-unix/X"$XVFB_DISPLAY" /tmp/.X11-unix/X"$XVFB_DISPLAY"
    --ro-bind "$XVFB_AUTH" "$XVFB_AUTH"
    --setenv DISPLAY ":$XVFB_DISPLAY"
    --setenv XAUTHORITY "$XVFB_AUTH"
  )
fi

#
# WSL interop
#
# Allow launching Windows executables via WSL interop. Windows processes run on
# the host, entirely outside of the sandbox, so this effectively removes it as a
# security boundary. The Windows drive is read-only, though a workspace within
# it remains writable.
#

WSL_BIND_ARGS=()
SANDBOX_PATH="$XDG_LOCAL_HOME"/bin:/usr/bin
if [ $WSL_INTEROP_ENABLED -eq 1 ]; then
  WSL_SYSTEMDRIVE=$(wslpath -u "$(wsl-env-var SYSTEMDRIVE)\\")
  WSL_SYSTEMDRIVE=${WSL_SYSTEMDRIVE%/}

  WSL_SYSTEMROOT=$(wslpath -u $(wsl-env-var SYSTEMROOT))

  WSL_BIND_ARGS=(
    --ro-bind /init /init
    --ro-bind /run/WSL /run/WSL
    --ro-bind "$WSL_SYSTEMDRIVE" "$WSL_SYSTEMDRIVE"
    --setenv WSL_INTEROP "$WSL_INTEROP"
    --setenv WSL_DISTRO_NAME "$WSL_DISTRO_NAME"
    --setenv WSLENV "$WSLENV"
  )

  SANDBOX_PATH+=:"$WSL_SYSTEMROOT"/System32
  SANDBOX_PATH+=:"$WSL_SYSTEMROOT"/System32/WindowsPowerShell/v1.0
fi

#
# Launch
#
# Launch opencode, either within bwrap or directly as the current user. Both
# share the same environment and inner script.
#
# The opencode binary itself is executed within an interactive bash shell, with
# arguments to this script passed directly. This is a workaround for:
# https://github.com/anomalyco/opencode/issues/9860
#
# `--norc` keeps the user's bashrc from altering PATH when not sandboxed.
#

COMMON_ENV=(
  DESKTOP_NOTIFY_IGNORE_FOCUS=$([ -n "$STY" ] || [ -n "$TMUX" ] && echo 1)
  EDITOR="drain-stdin $EDITOR_CMD"
  OPENCODE_SANDBOX_EXT_DIR="$OPENCODE_SANDBOX_EXT_DIR"
  TERM_TITLE_PREFIX="$TITLE_PREFIX"
  TERM_TITLE_SEP="$TITLE_SEP"
  TERM_TITLE_SUFFIX="$TITLE_SUFFIX"
  OPENCODE_DISABLE_FREE_MODELS=1
  OPENCODE_DISABLE_PROJECT_CONFIG=1
)

INNER_SCRIPT='
  "$OPENCODE_BIN" --standalone "$@"
  drain-stdin
'

#
# No sandbox
#
# Persist OpenCode data in the same place as the sandbox by symlinking its XDG
# directories. The links are idempotent and never removed, so concurrent
# instances are safe.
#

if [ $NO_SANDBOX -eq 1 ]; then
  link_opencode_dir() {
    local TARGET="$OPENCODE_HOME_DIR/$1" LINK="$2/opencode"

    mkdir -p "$TARGET" "$2"

    if [ -L "$LINK" ]; then
      [ "$(readlink "$LINK")" == "$TARGET" ] ||
        die "$(bpath "$LINK") is a symlink to something other than $(bpath "$TARGET")"
    elif [ -e "$LINK" ]; then
      die "$(bpath "$LINK") exists and is not a symlink to $(bpath "$TARGET")"
    else
      ln -s "$TARGET" "$LINK"
    fi
  }

  link_opencode_dir cache "$XDG_CACHE_HOME"
  link_opencode_dir config "$XDG_CONFIG_HOME"
  link_opencode_dir data "$XDG_DATA_HOME"
  link_opencode_dir state "$XDG_STATE_HOME"

  env -u SSH_CONNECTION -u SSH_CLIENT -u SSH_TTY \
    "${COMMON_ENV[@]}" \
    OPENCODE_BIN="$OPENCODE_INSTALL_DIR"/bin/opencode \
    PATH="$OPENCODE_HOME_DIR"/bin:"$PATH" \
  /bin/bash --norc -ic "$INNER_SCRIPT" /bin/bash "$@"

  exit $?
fi

#
# Bubblewrap
#

COMMON_SETENV_ARGS=()
for KV in "${COMMON_ENV[@]}"; do
  COMMON_SETENV_ARGS+=(--setenv "${KV%%=*}" "${KV#*=}")
done

/usr/bin/bwrap \
  --unshare-pid \
  --proc /proc \
  --dev /dev \
  --ro-bind /bin /bin \
  --ro-bind /usr/bin /usr/bin \
  --ro-bind /usr/share/terminfo /usr/share/terminfo \
  --ro-bind /lib /lib \
  --ro-bind /usr/lib /usr/lib \
  --ro-bind /lib64 /lib64 \
  --ro-bind /usr/lib64 /usr/lib64 \
  --ro-bind /etc/alternatives /etc/alternatives \
  --ro-bind /etc/resolv.conf /etc/resolv.conf \
  --ro-bind-try /etc/ssl /etc/ssl \
  --ro-bind-try /etc/ca-certificates /etc/ca-certificates \
  --ro-bind-try /etc/pki /etc/pki \
  --ro-bind "$OPENCODE_INSTALL_DIR" /opt/opencode \
  --dir "$HOME" \
  "${LINK_BIND_ARGS[@]}" \
  --ro-bind-try "$HOME/.gitconfig.user" "$HOME/.gitconfig" \
  --tmpfs /tmp \
  --tmpfs "$XDG_CACHE_HOME" \
  --bind "$OPENCODE_SANDBOX_EXT_DIR" "$OPENCODE_SANDBOX_EXT_DIR" \
  --bind "$OPENCODE_HOME_DIR"/cache "$XDG_CACHE_HOME"/opencode \
  --overlay-src "$OPENCODE_HOME_DIR"/config \
  --overlay "$CONFIG_OVERLAY_DIR"/config "$CONFIG_OVERLAY_DIR"/work "$XDG_CONFIG_HOME"/opencode \
  --ro-bind-try "$OPENCODE_HOME_DIR"/config/opencode.jsonc "$XDG_CONFIG_HOME"/opencode/opencode.jsonc \
  --ro-bind-try "$OPENCODE_HOME_DIR"/config/AGENTS.md "$XDG_CONFIG_HOME"/opencode/AGENTS.md \
  --ro-bind-try "$OPENCODE_HOME_DIR"/config/plugins "$XDG_CONFIG_HOME"/opencode/plugins \
  --bind "$OPENCODE_HOME_DIR"/data "$XDG_DATA_HOME"/opencode \
  --bind "$OPENCODE_HOME_DIR"/state "$XDG_STATE_HOME"/opencode \
  --ro-bind "$OPENCODE_HOME_DIR"/bin "$XDG_LOCAL_HOME"/bin \
  "${WSL_BIND_ARGS[@]}" \
  --bind "$WORKSPACE_DIR" "$WORKSPACE_DIR" \
  --chdir "$WORKSPACE_DIR" \
  --clearenv \
  "${COMMON_SETENV_ARGS[@]}" \
  --setenv OPENCODE_BIN /opt/opencode/bin/opencode \
  --setenv HOME "$HOME" \
  --setenv PATH "$SANDBOX_PATH" \
  --setenv PWD "$WORKSPACE_DIR" \
  --setenv TERM "$TERM" \
  --setenv XDG_CONFIG_HOME "$XDG_CONFIG_HOME" \
  --setenv XDG_LOCAL_HOME "$XDG_LOCAL_HOME" \
  --setenv XDG_DATA_HOME "$XDG_DATA_HOME" \
  --setenv XDG_STATE_HOME "$XDG_STATE_HOME" \
  --setenv XDG_CACHE_HOME "$XDG_CACHE_HOME" \
  "${EDITOR_BIND_ARGS[@]}" \
  "${XVFB_BIND_ARGS[@]}" \
/bin/bash --norc -ic "$INNER_SCRIPT" /bin/bash "$@"
